     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap mii-cm-mtb-therapiestatusgrund-obds</b></p><a name=\"mii-cm-mtb-therapiestatusgrund-obds\"> </a><a name=\"hcmii-cm-mtb-therapiestatusgrund-obds\"> </a><p>Mapping from <a href=\"ValueSet-mii-vs-mtb-therapiestatusgrund.html\">MII VS Therapiestatusgrund</a> to https://basisdatensatz.de</p><br/><p>Mapping from <a href=\"CodeSystem-mii-cs-mtb-therapiestatusgrund.html\">MII CS Therapiestatusgrund</a> to <code>https://basisdatensatz.de</code></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td></tr><tr><td>patient-refusal (Therapie durch Patient abgelehnt)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>V (Patient verweigert weitere Therapie)</td></tr><tr><td>patient-death (Tod)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>T (Patient verstorben)</td></tr><tr><td>chronic-remission (Anhaltende Remission)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>S (Abbruch aus sonstigen Gründen)</td></tr><tr><td>progression</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>P (Abbruch wegen Progress)</td></tr><tr><td>toxicity (Toxizität)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>A (Abbruch wegen Nebenwirkungen)</td></tr><tr><td>deterioration (Zustandsverschlechterung)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>S (Abbruch aus sonstigen Gründen)</td></tr><tr><td>regular-completion (Reguläres Ende)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>E (reguläres Ende)</td></tr><tr><td>regular-completion-with-dosage-reduction (Reguläres Ende mit Dosisreduktion)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>R (reguläres Ende mit Dosisreduktion)</td></tr><tr><td>regular-completion-with-substance-change (Reguläres Ende mit Substanzwechsel)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>W (reguläres Ende mit Substanzwechsel)</td></tr><tr><td>other (Weitere Gründe)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>S (Abbruch aus sonstigen Gründen)</td></tr><tr><td>unknown (Unbekannt)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>U (unbekannt)</td></tr></table></div>"
