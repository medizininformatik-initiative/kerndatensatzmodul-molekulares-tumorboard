    object MII_PR_MTB_Genomic_Study $colors.Procedure
    
}

package profiles.Follow-Up.Systemtherapie <<Rectangle>> {
    object MII_PR_MTB_Response_Befund $colors.Observation
    object MII_PR_MTB_Systemtherapie $colors.MedicationStatement
    
}

package profiles.Behandlungsepisode <<Rectangle>> {
    object MII_PR_MTB_Systemische_Therapie $colors.Procedure
