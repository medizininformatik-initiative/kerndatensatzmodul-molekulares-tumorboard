    object MII_PR_MTB_RNA_Seq $colors.Observation
    object MII_PR_MTB_DNA_Fusion $colors.Observation
    object MII_PR_MTB_MOLECULAR_PATHOLOGY_REPORT $colors.DiagnosticReport
    object MII_PR_MTB_Diagnostische_Implikation $colors.Observation
    object MII_PR_MTB_HRD_Score $colors.Observation
    object MII_PR_MTB_IMMUNOHISTOCHEMISTRY $colors.Observation
