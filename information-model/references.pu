@startuml references-mtb

!$colors = {"CarePlan": "#6f7bfa", "Claim": "#e86a6e", "ClaimResponse": "#e68cfe", "ClinicalImpression": "#81f472", "Condition": "#846dad", "DiagnosticReport": "#76f2dd", "MedicationRequest": "#6db9a5", "MedicationStatement": "#faa9bd", "Observation": "#987eee", "Procedure": "#fca174", "RequestGroup": "#85706b", "ResearchStudy": "#f1f979", "ServiceRequest": "#fb6abb"}

legend right
    |Color|Type|
    |<$colors.CarePlan>|CarePlan|
    |<$colors.Claim>|Claim|
    |<$colors.ClaimResponse>|ClaimResponse|
    |<$colors.ClinicalImpression>|ClinicalImpression|
    |<$colors.Condition>|Condition|
    |<$colors.DiagnosticReport>|DiagnosticReport|
    |<$colors.MedicationRequest>|MedicationRequest|
    |<$colors.MedicationStatement>|MedicationStatement|
    |<$colors.Observation>|Observation|
    |<$colors.Procedure>|Procedure|
    |<$colors.RequestGroup>|RequestGroup|
    |<$colors.ResearchStudy>|ResearchStudy|
    |<$colors.ServiceRequest>|ServiceRequest|
    endlegend

package profiles.Beschluss-Therapieplan <<Rectangle>> {
    object MII_PR_MTB_Humangenetische_Beratung_Auftrag $colors.ServiceRequest
    object MII_PR_MTB_Biopsie_Auftrag $colors.ServiceRequest
    object MII_PR_MTB_Studieneinschluss_Anfrage $colors.ServiceRequest
    object MII_PR_MTB_Therapieempfehlung_Kombination $colors.RequestGroup
    object MII_PR_MTB_Tumorzellgehalt $colors.Observation
    object MII_PR_MTB_Studie $colors.ResearchStudy
    object MII_PR_MTB_Therapieempfehlung $colors.MedicationRequest
    object MII_PR_MTB_Therapieplan $colors.CarePlan
    object MII_PR_MTB_Histologie_Evaluation_Auftrag $colors.ServiceRequest
    
}

package profiles.NGS-Bericht <<Rectangle>> {
    object MII_PR_MTB_IMMUNOHISTOCHEMISTRY_PDL1 $colors.Observation
