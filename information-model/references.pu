    object MII_PR_MTB_NGS_Bericht $colors.DiagnosticReport
    object MII_PR_MTB_Copy_Number_Variant $colors.Observation
    object MII_PR_MTB_Mutationslast $colors.Observation
    object MII_PR_MTB_HISTOCHEMISTRY $colors.Observation
