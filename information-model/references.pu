    object MII_PR_MTB_Behandlungsepisode $colors.ClinicalImpression
    
}

package profiles.Follow-Up <<Rectangle>> {
    object MII_PR_MTB_Follow_Up_ClinicalImpression $colors.ClinicalImpression
    object MII_PR_MTB_Follow_Up_Procedure $colors.Procedure
    object MII_PR_MTB_Follow_Up_CarePlan $colors.CarePlan
    
}

package profiles.Follow-Up.Kostenuebernahme <<Rectangle>> {
    object MII_PR_MTB_Antwort_Kostenuebernahme $colors.ClaimResponse
    object MII_PR_MTB_Antrag_Kostenuebernahme $colors.Claim
    
}

