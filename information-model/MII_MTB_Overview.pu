    object MII_Onko_Tumorkonferenz
}

package MII_Modul_Molekulares_Tumorboard {
    object Probe
    Bioprobe <|... Probe

    object IHC_Befund
    object ISH_Befund
    ' MII_Patho_Finding <|--- IHC_Befund 
    ' MII_Patho_Finding <|... ISH_Befund  
    MII_Molekularer_Biomarker <|--- IHC_Befund 
    MII_Molekularer_Biomarker <|--- ISH_Befund  

    object NGS_Bericht 
    MII_Molekulargenetischer_Befundbericht <|-left-- NGS_Bericht
    MII_Molekulargenetischer_Befundbericht -[hidden]down- MII_Variante

    object Einfache_Variante
    object RNA_Seq
    object RNA_Fusion
    object DNA_Fusion
    object CopyNumberVariation
    object FISH_Befund
    object Studie
    object Therapieplan
    object Therapieempfehlung
    object SystemischeTherapie
    object BRCAness
    object HRDScore
    object TMB
    object MSI
    object MMR
    object PDL1
    object HER2

    IHC_Befund <|--- PDL1
    IHC_Befund <|--- HER2
    MII_Molekularer_Biomarker <|--- MSI
    MII_Molekularer_Biomarker <|--- MMR
    MII_Molekularer_Biomarker <|--- TMB
    MII_Molekularer_Biomarker <|--- BRCAness
    MII_Molekularer_Biomarker <|--- HRDScore
    MII_MedicationRequest <|--- Therapieempfehlung
    MII_Onko_Tumorkonferenz <|--- Therapieplan
    MII_Studie <|--- Studie
    MII_Variante <|--- Einfache_Variante
    MII_Variante <|--- RNA_Seq
    MII_Variante <|--- RNA_Fusion
    MII_Variante <|--- DNA_Fusion
    MII_Variante <|--- CopyNumberVariation
    MII_Variante <|--- FISH_Befund
    Einfache_Variante -[hidden]down- RNA_Seq
    RNA_Seq -[hidden]down- RNA_Fusion
    RNA_Fusion -[hidden]down- DNA_Fusion
    DNA_Fusion -[hidden]down- CopyNumberVariation
    CopyNumberVariation -[hidden]down- FISH_Befund

    object Diagnose
    object Vortherapie
    MII_Onko_Diagnose <|--- Diagnose
    MII_Onko_Systemische_Therapie <|--- SystemischeTherapie
    MII_Onko_Systemische_Therapie <|--- Vortherapie
    ISH_Befund -[hidden]right- IHC_Befund 
    Diagnose  -[hidden]down-Vortherapie
    


package MII_MTB_Neuprofilierungen {
    object MTB_Behandlungsepisode
    object AntragKostenübernahme
    object AntwortKostenübernahme
    object ResponseBefund
    object Followup
    object OncoTree
    object Tumorausbreitung
    object WHO_Grad
    object BiopsieAuftrag
    object NGSAuftrag
    object HistologieEvaluationAuftrag
    object HumangenetischeBeratungAuftrag
    object StudieneinschlussAnfrage
    object Tumorzellgehalt
    object TherapieempfehlungKombinationstherapie
    object MolekularPathologieReport 
}


ISH_Befund -[hidden]down- MII_MTB_Neuprofilierungen
}
MII_Modul_Biobank -[hidden]left-  MII_Modul_Molekulares_Tumorboard

MII_Modul_Onkologie -[hidden]left-  MII_Modul_Molekulares_Tumorboard
MII_Modul_Onkologie -[hidden]left-   Diagnose
MII_Onko_Diagnose -[hidden]down- MII_Onko_Systemische_Therapie

