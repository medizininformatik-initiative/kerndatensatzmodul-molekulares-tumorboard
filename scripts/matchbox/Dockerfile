# DNPM → MII-MTB Matchbox image
# Extends the official Matchbox image with:
# - Custom application.yaml (httpReadOnly=false, H2 in-memory DB)
# - DNPM LogicalModel StructureDefinitions (compiled via SUSHI)
# - FML StructureMaps for DNPM → MII-MTB transformation
# - Init script that loads maps on first start

FROM europe-west6-docker.pkg.dev/ahdis-ch/ahdis/matchbox:v4.0.20

# --- Configuration ---
COPY scripts/matchbox/application.yaml /config/application.yaml

# --- FML StructureMaps ---
COPY input/maps/*.fml /maps/

# --- Compiled DNPM LogicalModel StructureDefinitions ---
# These are generated by running SUSHI: `sushi .`
# Output lands in fsh-generated/resources/StructureDefinition-dnpm-lm-*.json
COPY fsh-generated/resources/StructureDefinition-dnpm-lm-*.json /structuredefinitions/

# --- Init script ---
COPY --chmod=755 scripts/matchbox/init-maps.sh /init-maps.sh

# Expose port
EXPOSE 8080

# Override entrypoint: start Matchbox in background (using original command),
# then load the FML maps once it's healthy, then wait.
ENTRYPOINT ["/bin/sh", "-c", \
  "java -Xmx3072M -Dfhir.settings.path=/config/fhir-settings.json \
   -Dspring.config.additional-location=optional:file:/config/application.yaml \
   -jar /matchbox.jar & /init-maps.sh ; wait"]
