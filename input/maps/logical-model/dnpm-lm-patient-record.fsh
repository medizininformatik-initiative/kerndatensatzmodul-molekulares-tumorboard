  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * specimen 1..1 BackboneElement "Tumor specimen reference"
    * id 1..1 string "Specimen ID"
    * type 1..1 string "Reference type (TumorSpecimen)"
  * issuedOn 1..1 string "Report issue date (YYYY-MM-DD)"
  * results 0..1 BackboneElement "IHC results"
    * proteinExpression 0..* BackboneElement "Protein expression results"
      * id 1..1 string "Result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type (Patient)"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type (TumorSpecimen)"
      * protein 1..1 BackboneElement "Protein tested"
        * code 1..1 string "Protein code (e.g. BRAFP1)"
        * display 0..1 string "Protein display"
        * system 1..1 string "Protein system URI"
      * value 0..1 BackboneElement "IHC expression value"
        * code 1..1 string "Score code (e.g. 1+)"
        * display 0..1 string "Score display"
        * system 1..1 string "Score system URI"
      * tpsScore 0..1 integer "Tumor proportion score (TPS)"
      * icScore 0..1 BackboneElement "Immune-cell score"
        * code 1..1 string "IC score code"
        * display 0..1 string "IC score display"
        * system 1..1 string "IC score system URI"
      * tcScore 0..1 BackboneElement "Tumor-cell score"
        * code 1..1 string "TC score code"
        * display 0..1 string "TC score display"
        * system 1..1 string "TC score system URI"
    * msiMmr 0..* BackboneElement "MSI / MMR protein expression results"
      * id 1..1 string "Result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type (Patient)"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type (TumorSpecimen)"
      * protein 1..1 BackboneElement "MMR protein tested (e.g. MLH1)"
        * code 1..1 string "Protein code"
        * display 0..1 string "Protein display"
        * system 1..1 string "Protein system URI"
      * value 0..1 BackboneElement "Expression result"
        * code 1..1 string "Result code (e.g. exp_present)"
        * display 0..1 string "Result display"
        * system 1..1 string "Result system URI"

// =============================================================================
// 12. msiFindings
// =============================================================================
* msiFindings 0..* BackboneElement "Microsatellite instability (MSI) findings"
  * id 1..1 string "MSI finding UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * specimen 1..1 BackboneElement "Tumor specimen reference"
    * id 1..1 string "Specimen ID"
    * type 1..1 string "Reference type (TumorSpecimen)"
  * ngsReport 0..1 BackboneElement "Associated NGS report reference"
    * id 1..1 string "NGS report ID"
    * type 1..1 string "Reference type (NGSReport)"
  * issuedOn 1..1 string "Finding date (YYYY-MM-DD)"
  * value 1..1 BackboneElement "MSI result value"
    * code 1..1 string "MSI code (e.g. MSI-H)"
    * display 0..1 string "MSI display"
    * system 1..1 string "MSI system URI"
  * method 0..1 BackboneElement "MSI determination method"
    * code 1..1 string "Method code (e.g. bioinformatics)"
    * display 0..1 string "Method display"
    * system 1..1 string "Method system URI"

// =============================================================================
// 13. ngsReports
// (Full inline definition; canonical definition in dnpm-lm-ngs-report.fsh)
// =============================================================================
* ngsReports 0..* BackboneElement "NGS sequencing reports"
  * id 1..1 string "NGS Report UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * specimen 1..1 BackboneElement "Tumor specimen reference"
    * id 1..1 string "Specimen ID"
    * type 1..1 string "Reference type (TumorSpecimen)"
  * issuedOn 1..1 string "Report issue date (YYYY-MM-DD)"
  * type 1..1 BackboneElement "NGS analysis type"
    * code 1..1 string "Type code (e.g. exome)"
    * display 0..1 string "Type display"
    * system 1..1 string "Type system URI"
  * metadata 0..1 BackboneElement "NGS run metadata"
    * referenceGenome 0..1 BackboneElement "Reference genome"
      * code 1..1 string "Genome build (e.g. GRCh38)"
      * display 0..1 string "Genome build display"
      * system 1..1 string "Genome build system URI"
    * sequencer 0..1 BackboneElement "Sequencer instrument"
      * code 1..1 string "Sequencer code"
      * display 0..1 string "Sequencer display"
      * system 1..1 string "Sequencer system URI"
    * kitManufacturer 0..1 string "Kit manufacturer"
    * kitType 0..1 string "Kit type"
    * pipeline 0..1 string "Bioinformatics pipeline"
    * tumorCellContent 0..1 BackboneElement "Pre-sequencing tumor cell content estimate"
      * method 0..1 BackboneElement "Estimation method"
        * code 1..1 string "Method code"
        * display 0..1 string "Method display"
        * system 1..1 string "Method system URI"
      * value 1..1 decimal "Fraction (0.0 – 1.0)"
  * results 1..1 BackboneElement "NGS analysis results"
    * tumorCellContent 0..1 BackboneElement "Bioinformatic tumor cell content"
      * id 1..1 string "Result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type"
      * method 1..1 BackboneElement "Determination method"
        * code 1..1 string "Method code (e.g. bioinformatic)"
        * display 0..1 string "Method display"
        * system 1..1 string "Method system URI"
      * value 1..1 decimal "Fraction (0.0 – 1.0)"
    * tmb 0..1 BackboneElement "Tumor Mutational Burden"
      * id 1..1 string "TMB result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type"
      * value 1..1 BackboneElement "TMB quantity"
        * value 1..1 decimal "Numeric value"
        * unit 1..1 string "Unit"
      * interpretation 0..1 BackboneElement "TMB interpretation"
        * code 1..1 string "Code (e.g. high)"
        * display 0..1 string "Display"
        * system 1..1 string "System URI"
    * brcaness 0..1 BackboneElement "BRCAness score"
      * id 1..1 string "BRCAness result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type"
      * value 1..1 decimal "BRCAness score (0.0 – 1.0)"
      * confidenceRange 0..1 BackboneElement "Confidence range"
        * min 1..1 decimal "Minimum"
        * max 1..1 decimal "Maximum"
    * hrdScore 0..1 BackboneElement "HRD Score"
      * id 1..1 string "HRD result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type"
      * value 1..1 decimal "HRD composite score"
      * components 0..1 BackboneElement "HRD component scores"
        * lst 0..1 decimal "LST score"
        * loh 0..1 decimal "LOH score"
        * tai 0..1 decimal "TAI score"
      * interpretation 0..1 BackboneElement "HRD interpretation"
        * code 1..1 string "Code (e.g. low)"
        * display 0..1 string "Display"
        * system 1..1 string "System URI"
    * simpleVariants 0..* BackboneElement "Simple variants (SNV / small indels)"
      * id 1..1 string "Variant UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * externalIds 0..* BackboneElement "External identifiers (e.g. dbSNP)"
        * value 1..1 string "Identifier value"
        * system 1..1 string "Identifier system URI"
      * chromosome 1..1 string "Chromosome (e.g. chr4)"
      * gene 1..1 BackboneElement "Affected gene"
        * code 1..1 string "HGNC gene code"
        * display 0..1 string "Gene symbol"
        * system 1..1 string "Gene nomenclature system URI"
      * localization 0..* BackboneElement "Variant localization in gene"
        * code 1..1 string "Localization code"
        * display 0..1 string "Localization display"
        * system 1..1 string "Localization system URI"
      * transcriptId 0..1 BackboneElement "Transcript identifier"
        * value 1..1 string "Transcript ID (e.g. ENST...)"
        * system 1..1 string "Transcript system URI"
      * exonId 0..1 string "Exon identifier"
      * position 0..1 BackboneElement "Genomic position"
        * start 1..1 integer "Start position"
        * end 0..1 integer "End position"
      * altAllele 1..1 string "Alternate allele"
      * refAllele 1..1 string "Reference allele"
      * dnaChange 0..1 string "cDNA change (HGVS)"
      * proteinChange 0..1 string "Protein change (HGVS)"
      * readDepth 0..1 integer "Read depth"
      * allelicFrequency 0..1 decimal "Allelic frequency"
      * interpretation 0..1 BackboneElement "ClinVar interpretation"
        * code 1..1 string "Interpretation code"
        * display 0..1 string "Interpretation display"
        * system 1..1 string "Interpretation system URI"
    * copyNumberVariants 0..* BackboneElement "Copy number variants"
      * id 1..1 string "CNV UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * chromosome 1..1 string "Chromosome (e.g. chr7)"
      * localization 0..* BackboneElement "CNV localization"
        * code 1..1 string "Localization code"
        * display 0..1 string "Localization display"
        * system 1..1 string "Localization system URI"
      * startRange 0..1 BackboneElement "Start position range"
        * start 1..1 integer "Range start"
        * end 1..1 integer "Range end"
      * endRange 0..1 BackboneElement "End position range"
        * start 1..1 integer "Range start"
        * end 1..1 integer "Range end"
      * totalCopyNumber 0..1 integer "Total copy number"
      * relativeCopyNumber 0..1 decimal "Relative copy number"
      * cnA 0..1 integer "Copy number allele A"
      * cnB 0..1 integer "Copy number allele B"
      * reportedAffectedGenes 0..* BackboneElement "Affected genes"
        * code 1..1 string "HGNC gene code"
        * display 0..1 string "Gene symbol"
        * system 1..1 string "Gene nomenclature system URI"
      * focality 0..1 BackboneElement "CNV focality"
        * code 1..1 string "Focality code (e.g. focal)"
        * display 0..1 string "Focality display"
        * system 1..1 string "Focality system URI"
      * type 1..1 BackboneElement "CNV type"
        * code 1..1 string "CNV type code (e.g. gain)"
        * display 0..1 string "CNV type display"
        * system 1..1 string "CNV type system URI"
    * dnaFusions 0..* BackboneElement "DNA-level gene fusions"
      * id 1..1 string "DNA fusion UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * localization 0..* BackboneElement "Fusion localization"
        * code 1..1 string "Localization code"
        * display 0..1 string "Localization display"
        * system 1..1 string "Localization system URI"
      * fusionPartner5prime 0..1 BackboneElement "5-prime fusion partner"
        * gene 1..1 BackboneElement "5-prime partner gene"
          * code 1..1 string "HGNC gene code"
          * display 0..1 string "Gene symbol"
          * system 1..1 string "Gene nomenclature system URI"
        * position 1..1 integer "Breakpoint position"
      * fusionPartner3prime 0..1 BackboneElement "3-prime fusion partner"
        * gene 1..1 BackboneElement "3-prime partner gene"
          * code 1..1 string "HGNC gene code"
          * display 0..1 string "Gene symbol"
          * system 1..1 string "Gene nomenclature system URI"
        * position 1..1 integer "Breakpoint position"
      * reportedNumReads 0..1 integer "Supporting read count"
    * rnaFusions 0..* BackboneElement "RNA-level gene fusions"
      * id 1..1 string "RNA fusion UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type"
      * externalIds 0..* BackboneElement "External identifiers (e.g. COSMIC)"
        * value 1..1 string "Identifier value"
        * system 1..1 string "Identifier system URI"
      * localization 0..* BackboneElement "Fusion localization"
        * code 1..1 string "Localization code"
        * display 0..1 string "Localization display"
        * system 1..1 string "Localization system URI"
      * fusionPartner5prime 0..1 BackboneElement "5-prime fusion partner"
        * gene 1..1 BackboneElement "5-prime partner gene"
          * code 1..1 string "HGNC gene code"
          * display 0..1 string "Gene symbol"
          * system 1..1 string "Gene nomenclature system URI"
        * transcript 0..1 BackboneElement "5-prime transcript"
          * value 1..1 string "Transcript ID (e.g. ENST...)"
          * system 1..1 string "Transcript system URI"
        * exon 0..1 string "Exon identifier"
        * position 1..1 integer "Breakpoint position"
        * strand 0..1 string "Strand (+ or -)"
      * fusionPartner3prime 0..1 BackboneElement "3-prime fusion partner"
        * gene 1..1 BackboneElement "3-prime partner gene"
          * code 1..1 string "HGNC gene code"
          * display 0..1 string "Gene symbol"
          * system 1..1 string "Gene nomenclature system URI"
        * transcript 0..1 BackboneElement "3-prime transcript"
          * value 1..1 string "Transcript ID (e.g. ENST...)"
          * system 1..1 string "Transcript system URI"
        * exon 0..1 string "Exon identifier"
        * position 1..1 integer "Breakpoint position"
        * strand 0..1 string "Strand (+ or -)"
      * effect 0..1 BackboneElement "RNA fusion effect"
        * code 1..1 string "Effect code (e.g. in-frame)"
        * display 0..1 string "Effect display"
        * system 1..1 string "Effect system URI"
      * reportedNumReads 0..1 integer "Supporting read count"

// =============================================================================
// 14. carePlans
// (Full inline definition; canonical definition in dnpm-lm-care-plan.fsh)
// =============================================================================
* carePlans 0..* BackboneElement "MTB care plans"
  * id 1..1 string "Care plan UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * issuedOn 1..1 string "Issue date (YYYY-MM-DD)"
  * reason 0..1 BackboneElement "Indication (MTBDiagnosis) reference"
    * id 1..1 string "Diagnosis ID"
    * type 1..1 string "Reference type (MTBDiagnosis)"
  * noTargetFinding 0..1 boolean "True when no actionable target was found"
  * geneticCounselingRecommendation 0..1 BackboneElement "Genetic counselling recommendation"
    * id 1..1 string "Recommendation UUID"
    * patient 1..1 BackboneElement "Patient reference"
      * id 1..1 string "Patient ID"
      * type 1..1 string "Reference type (Patient)"
    * issuedOn 1..1 string "Recommendation date (YYYY-MM-DD)"
    * reason 0..1 BackboneElement "Counselling reason"
      * code 1..1 string "Reason code"
      * display 0..1 string "Reason display"
      * system 1..1 string "Reason system URI"
  * medicationRecommendations 0..* BackboneElement "Medication therapy recommendations"
    * id 1..1 string "Recommendation UUID"
    * patient 1..1 BackboneElement "Patient reference"
      * id 1..1 string "Patient ID"
      * type 1..1 string "Reference type (Patient)"
    * issuedOn 1..1 string "Recommendation date (YYYY-MM-DD)"
    * indication 0..1 BackboneElement "Indication reference"
      * id 1..1 string "Diagnosis ID"
      * type 1..1 string "Reference type (MTBDiagnosis)"
    * priority 0..1 BackboneElement "Recommendation priority"
      * code 1..1 string "Priority code (e.g. 1)"
      * display 0..1 string "Priority display"
      * system 1..1 string "Priority system URI"
    * medication 0..* BackboneElement "Recommended medications (ATC)"
      * code 1..1 string "ATC code"
      * display 0..1 string "Medication display"
      * system 1..1 string "ATC system URI"
      * version 0..1 string "ATC version"
    * supportingVariants 0..* BackboneElement "Supporting variants"
      * id 1..1 string "Variant ID"
      * type 1..1 string "Variant type (SNV | CNV | DNAFusion | RNAFusion)"
    * levelOfEvidence 0..1 BackboneElement "Level of evidence"
      * grading 0..1 BackboneElement "Evidence grading"
        * code 1..1 string "Grade code (e.g. m1A)"
        * display 0..1 string "Grade display"
        * system 1..1 string "Grade system URI"
      * addendums 0..* BackboneElement "Evidence addendums"
        * code 1..1 string "Addendum code"
        * display 0..1 string "Addendum display"
        * system 1..1 string "Addendum system URI"
      * publications 0..* BackboneElement "Supporting publications"
        * pmid 0..1 string "PubMed ID"
        * doi 0..1 string "Digital Object Identifier"
  * studyEnrollmentRecommendations 0..* BackboneElement "Study enrollment recommendations"
    * id 1..1 string "Recommendation UUID"
    * patient 1..1 BackboneElement "Patient reference"
      * id 1..1 string "Patient ID"
      * type 1..1 string "Reference type (Patient)"
    * issuedOn 1..1 string "Recommendation date (YYYY-MM-DD)"
    * indication 0..1 BackboneElement "Indication reference"
      * id 1..1 string "Diagnosis ID"
      * type 1..1 string "Reference type (MTBDiagnosis)"
    * supportingVariants 0..* BackboneElement "Supporting variants"
      * id 1..1 string "Variant ID"
      * type 1..1 string "Variant type"
    * studies 0..* BackboneElement "Recommended studies"
      * id 1..1 string "Study ID (e.g. NCT number)"
      * system 1..1 string "Study registry system URI"

// =============================================================================
// 15. followUps
// =============================================================================
* followUps 0..* BackboneElement "Follow-up visit entries"
  * id 1..1 string "Follow-up UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * date 1..1 string "Follow-up date (YYYY-MM-DD)"
  * lastContactDate 0..1 string "Date of last patient contact (YYYY-MM-DD)"
  * patientStatus 0..1 BackboneElement "Patient status at follow-up"
    * code 1..1 string "Status code (e.g. alive)"
    * display 0..1 string "Status display"
    * system 1..1 string "Status system URI"
  * claims 0..* BackboneElement "Claim references at follow-up"
    * id 1..1 string "Claim ID"
    * type 1..1 string "Reference type (Claim)"
  * therapyChanged 0..1 boolean "Whether therapy was changed at this follow-up"

// =============================================================================
// 16. claims
// =============================================================================
* claims 0..* BackboneElement "Insurance / cost coverage claim entries"
  * id 1..1 string "Claim UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * recommendation 1..1 BackboneElement "Associated medication recommendation reference"
    * id 1..1 string "Recommendation ID"
    * type 1..1 string "Reference type (MTBMedicationRecommendation)"
  * issuedOn 1..1 string "Claim issue date (YYYY-MM-DD)"

// =============================================================================
// 17. claimResponses
// =============================================================================
* claimResponses 0..* BackboneElement "Insurance / cost coverage claim response entries"
  * id 1..1 string "Claim response UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * claim 1..1 BackboneElement "Associated claim reference"
    * id 1..1 string "Claim ID"
    * type 1..1 string "Reference type (Claim)"
  * issuedOn 1..1 string "Response date (YYYY-MM-DD)"
  * status 1..1 BackboneElement "Response status"
    * code 1..1 string "Status code (e.g. rejected)"
    * display 0..1 string "Status display"
    * system 1..1 string "Status system URI"
  * statusReason 0..1 BackboneElement "Reason for response status"
    * code 1..1 string "Reason code"
    * display 0..1 string "Reason display"
    * system 1..1 string "Reason system URI"

// =============================================================================
// 18. systemicTherapies
// Note: each array element wraps a `history` array; actual therapy data is in
// history[]. This two-level structure reflects the DNPM API design.
// =============================================================================
* systemicTherapies 0..* BackboneElement "Systemic (molecular) therapy entries (each wraps a history)"
  * history 0..* BackboneElement "Therapy version history entries"
    * id 1..1 string "Therapy entry UUID"
    * patient 1..1 BackboneElement "Patient reference"
      * id 1..1 string "Patient ID"
      * type 1..1 string "Reference type (Patient)"
    * indication 0..1 BackboneElement "Indication reference"
      * id 1..1 string "Diagnosis ID"
      * type 1..1 string "Reference type (MTBDiagnosis)"
    * basedOn 0..1 BackboneElement "Medication recommendation reference"
      * id 1..1 string "Recommendation ID"
      * type 1..1 string "Reference type (MTBMedicationRecommendation)"
    * therapyLine 0..1 integer "Therapy line number"
    * status 0..1 BackboneElement "Therapy status"
      * code 1..1 string "Status code (e.g. completed)"
      * display 0..1 string "Status display"
      * system 1..1 string "Status system URI"
    * statusReason 0..1 BackboneElement "Reason for therapy status"
      * code 1..1 string "Status reason code"
      * display 0..1 string "Status reason display"
      * system 1..1 string "Status reason system URI"
    * period 0..1 BackboneElement "Therapy period"
      * start 1..1 string "Start date (YYYY-MM-DD)"
      * end 0..1 string "End date (YYYY-MM-DD)"
    * medication 0..* BackboneElement "Medication codes (ATC)"
      * code 1..1 string "ATC code"
      * display 0..1 string "Medication display"
      * system 1..1 string "ATC system URI"
      * version 0..1 string "ATC version"
    * notes 0..* string "Free-text therapy notes"

// =============================================================================
// 19. responses
// =============================================================================
* responses 0..* BackboneElement "Therapy response assessments"
  * id 1..1 string "Response UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * therapy 1..1 BackboneElement "Associated systemic therapy reference"
    * id 1..1 string "Therapy ID"
    * type 1..1 string "Reference type (MTBSystemicTherapy)"
  * effectiveDate 1..1 string "Response assessment date (YYYY-MM-DD)"
  * value 1..1 BackboneElement "RECIST response category"
    * code 1..1 string "RECIST code (e.g. SD, PR, CR, PD)"
    * display 0..1 string "RECIST display (e.g. Stable Disease)"
    * system 1..1 string "RECIST system (e.g. RECIST)"
