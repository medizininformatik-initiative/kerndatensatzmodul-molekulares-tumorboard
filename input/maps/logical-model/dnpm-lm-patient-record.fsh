// dnpm-lm-patient-record.fsh
// Root Logical Model for the DNPM DIP MTB Patient Record JSON structure.
// Models all 19 top-level keys returned by the DNPM API endpoint
// https://dnpm-dip.net/api/mtb/fake/data/patient-record
// Complex sub-structures for ngsReports and carePlans are described in their own
// dedicated files (dnpm-lm-ngs-report.fsh / dnpm-lm-care-plan.fsh); the
// corresponding arrays here carry the same field set inline so that a single
// StructureMap source can navigate the full record without cross-file references.

Logical: DNPM_LM_PatientRecord
Parent: Element
Id: dnpm-lm-patient-record
Title: "DNPM Patient Record"
Description: "Logical Model for the DNPM DIP MTB Patient Record JSON structure (all 19 top-level keys)"
* ^url = "https://dnpm-dip.net/fhir/StructureDefinition/dnpm-lm-patient-record"
* ^status = #active

// =============================================================================
// 1. patient
// =============================================================================
* patient 1..1 BackboneElement "Patient demographics"
  * id 1..1 string "Patient UUID"
  * gender 1..1 BackboneElement "Patient gender"
    * code 1..1 string "Gender code (e.g. female)"
    * display 0..1 string "Gender display text"
    * system 1..1 string "Gender code system"
  * birthDate 1..1 string "Date of birth (YYYY-MM)"
  * healthInsurance 0..1 BackboneElement "Health insurance information"
    * type 1..1 BackboneElement "Insurance type coding"
      * code 1..1 string "Insurance type code (e.g. GKV)"
      * display 0..1 string "Insurance type display"
      * system 1..1 string "Insurance type system URI"
    * reference 0..1 BackboneElement "Insurance provider reference"
      * id 1..1 string "Insurance provider ID"
      * type 1..1 string "Reference type (HealthInsurance)"
      * display 0..1 string "Insurance provider display name"
      * system 0..1 string "Insurance provider system URI"
  * address 0..1 BackboneElement "Patient address (municipality)"
    * municipalityCode 0..1 string "AGS municipality code (5-digit)"
  * age 0..1 BackboneElement "Calculated patient age"
    * value 1..1 integer "Age numeric value"
    * unit 1..1 string "Age unit (e.g. Years)"
  * vitalStatus 1..1 BackboneElement "Vital status"
    * code 1..1 string "Vital status code (e.g. alive)"
    * display 0..1 string "Vital status display"
    * system 1..1 string "Vital status system URI"

// =============================================================================
// 2. episodesOfCare
// =============================================================================
* episodesOfCare 0..* BackboneElement "MTB episodes of care"
  * id 1..1 string "Episode UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * period 0..1 BackboneElement "Episode period"
    * start 1..1 string "Start date (YYYY-MM-DD)"
    * end 0..1 string "End date (YYYY-MM-DD)"
  * diagnoses 0..* BackboneElement "Diagnosis references within this episode"
    * id 1..1 string "Diagnosis ID"
    * type 1..1 string "Reference type (MTBDiagnosis)"

// =============================================================================
// 3. diagnoses
// =============================================================================
* diagnoses 0..* BackboneElement "MTB tumor diagnoses"
  * id 1..1 string "Diagnosis UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * recordedOn 0..1 string "Date diagnosis was recorded (YYYY-MM-DD)"
  * type 0..1 BackboneElement "Diagnosis type history (main / secondary)"
    * history 0..* BackboneElement "History entries for diagnosis type"
      * date 0..1 string "Entry date"
      * value 0..1 BackboneElement "Diagnosis type value"
        * code 1..1 string "Type code (e.g. main)"
        * display 0..1 string "Type display"
        * system 1..1 string "Type system URI"
  * code 1..1 BackboneElement "ICD-10-GM tumor diagnosis code"
    * code 1..1 string "ICD-10-GM code (e.g. C75.8)"
    * display 0..1 string "Diagnosis display text"
    * system 1..1 string "ICD-10-GM code system URI"
    * version 0..1 string "ICD-10-GM version year"
  * topography 0..1 BackboneElement "ICD-O-3 topography code"
    * code 1..1 string "Topography code"
    * display 0..1 string "Topography display"
    * system 1..1 string "Topography system URI (ICD-O-3)"
    * version 0..1 string "ICD-O-3 version"
  * grading 0..1 BackboneElement "Tumor grading history"
    * history 0..* BackboneElement "Grading history entries"
      * date 0..1 string "Grading date"
      * codes 0..* BackboneElement "Grading codes"
        * code 1..1 string "Grade code"
        * display 0..1 string "Grade display"
        * system 1..1 string "Grading system URI"
  * staging 0..1 BackboneElement "Tumor staging history"
    * history 0..* BackboneElement "Staging history entries"
      * date 0..1 string "Staging date"
      * method 0..1 BackboneElement "Staging method"
        * code 1..1 string "Method code (e.g. clinical)"
        * system 1..1 string "Method system URI"
      * tnmClassification 0..1 BackboneElement "TNM classification"
        * tumor 0..1 BackboneElement "T category"
          * code 1..1 string "T code (e.g. T0)"
          * system 1..1 string "TNM system (UICC)"
        * nodes 0..1 BackboneElement "N category"
          * code 1..1 string "N code (e.g. N2)"
          * system 1..1 string "TNM system (UICC)"
        * metastasis 0..1 BackboneElement "M category"
          * code 1..1 string "M code (e.g. M0)"
          * system 1..1 string "TNM system (UICC)"
      * otherClassifications 0..* BackboneElement "Other classification systems"
        * code 1..1 string "Classification code"
        * display 0..1 string "Classification display"
        * system 1..1 string "Classification system URI"
  * guidelineTreatmentStatus 0..1 BackboneElement "Guideline treatment exhaustion status"
    * code 1..1 string "Status code (e.g. non-exhausted)"
    * display 0..1 string "Status display"
    * system 1..1 string "Status system URI"
  * histology 0..* BackboneElement "Histology report references"
    * id 1..1 string "Histology report ID"
    * type 1..1 string "Reference type (HistologyReport)"
  * notes 0..* string "Free-text clinical notes"

// =============================================================================
// 4. familyMemberHistories
// =============================================================================
* familyMemberHistories 0..* BackboneElement "Family member cancer history entries"
  * id 1..1 string "Family member history UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * relationship 1..1 BackboneElement "Family relationship type"
    * code 1..1 string "Relationship code"
    * display 0..1 string "Relationship display"
    * system 1..1 string "Relationship system URI"

// =============================================================================
// 5. guidelineTherapies
// =============================================================================
* guidelineTherapies 0..* BackboneElement "Guideline-based therapy entries"
  * id 1..1 string "Therapy UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * indication 0..1 BackboneElement "Indication (MTBDiagnosis) reference"
    * id 1..1 string "Diagnosis ID"
    * type 1..1 string "Reference type (MTBDiagnosis)"
  * therapyLine 0..1 integer "Therapy line number"
  * status 0..1 BackboneElement "Therapy status"
    * code 1..1 string "Status code (e.g. stopped)"
    * display 0..1 string "Status display"
    * system 1..1 string "Status system URI"
  * statusReason 0..1 BackboneElement "Reason for therapy status"
    * code 1..1 string "Status reason code (e.g. progression)"
    * display 0..1 string "Status reason display"
    * system 1..1 string "Status reason system URI"
  * period 0..1 BackboneElement "Therapy period"
    * start 1..1 string "Start date (YYYY-MM-DD)"
    * end 0..1 string "End date (YYYY-MM-DD)"
  * medication 0..* BackboneElement "Medication codes (ATC)"
    * code 1..1 string "ATC code"
    * display 0..1 string "Medication display name"
    * system 1..1 string "ATC code system URI"
    * version 0..1 string "ATC version"
  * notes 0..* string "Free-text therapy notes"
  * category 0..1 BackboneElement "Therapy category"
    * code 1..1 string "Category code"
    * display 0..1 string "Category display"
    * system 1..1 string "Category system URI"

// =============================================================================
// 6. guidelineProcedures
// =============================================================================
* guidelineProcedures 0..* BackboneElement "Guideline-based non-medication procedures"
  * id 1..1 string "Procedure UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * indication 0..1 BackboneElement "Indication (MTBDiagnosis) reference"
    * id 1..1 string "Diagnosis ID"
    * type 1..1 string "Reference type (MTBDiagnosis)"
  * code 1..1 BackboneElement "Procedure type code"
    * code 1..1 string "Procedure code (e.g. radiotherapy)"
    * display 0..1 string "Procedure display"
    * system 1..1 string "Procedure system URI"
  * status 0..1 BackboneElement "Procedure status"
    * code 1..1 string "Status code (e.g. ongoing)"
    * display 0..1 string "Status display"
    * system 1..1 string "Status system URI"
  * period 0..1 BackboneElement "Procedure period"
    * start 1..1 string "Start date (YYYY-MM-DD)"
    * end 0..1 string "End date (YYYY-MM-DD)"
  * intent 0..1 BackboneElement "Therapy intent"
    * code 1..1 string "Intent code (e.g. palliative)"
    * display 0..1 string "Intent display"
    * system 1..1 string "Intent system URI"
  * notes 0..* string "Free-text procedure notes"

// =============================================================================
// 7. performanceStatus
// =============================================================================
* performanceStatus 0..* BackboneElement "ECOG performance status assessments"
  * id 1..1 string "Performance status UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * effectiveDate 1..1 string "Assessment date (YYYY-MM-DD)"
  * value 1..1 BackboneElement "ECOG score"
    * code 1..1 string "ECOG code (e.g. 0–4)"
    * display 0..1 string "ECOG display"
    * system 1..1 string "ECOG system URI"

// =============================================================================
// 8. specimens
// =============================================================================
* specimens 0..* BackboneElement "Tumor specimen entries"
  * id 1..1 string "Specimen UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * diagnosis 0..1 BackboneElement "Associated diagnosis reference"
    * id 1..1 string "Diagnosis ID"
    * type 1..1 string "Reference type (MTBDiagnosis)"
  * type 0..1 BackboneElement "Specimen type"
    * code 1..1 string "Specimen type code (e.g. fresh-tissue)"
    * display 0..1 string "Specimen type display"
    * system 1..1 string "Specimen type system URI"
  * collection 0..1 BackboneElement "Specimen collection details"
    * date 0..1 string "Collection date (YYYY-MM-DD)"
    * site 0..1 BackboneElement "Collection site (ICD-O-3 topography)"
      * code 1..1 string "Site code"
      * display 0..1 string "Site display"
      * system 1..1 string "Site system URI"
      * version 0..1 string "ICD-O-3 version"
    * method 0..1 BackboneElement "Collection method"
      * code 1..1 string "Method code (e.g. biopsy)"
      * display 0..1 string "Method display"
      * system 1..1 string "Method system URI"

// =============================================================================
// 9. priorDiagnosticReports
// =============================================================================
* priorDiagnosticReports 0..* BackboneElement "Prior diagnostic reports (free-text)"
  * id 1..1 string "Report UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * issuedOn 1..1 string "Report issue date (YYYY-MM-DD)"
  * results 0..* string "Free-text diagnostic result strings"

// =============================================================================
// 10. histologyReports
// =============================================================================
* histologyReports 0..* BackboneElement "Histology report entries"
  * id 1..1 string "Histology report UUID"
  * patient 1..1 BackboneElement "Patient reference"
    * id 1..1 string "Patient ID"
    * type 1..1 string "Reference type (Patient)"
  * specimen 1..1 BackboneElement "Tumor specimen reference"
    * id 1..1 string "Specimen ID"
    * type 1..1 string "Reference type (TumorSpecimen)"
  * issuedOn 1..1 string "Report issue date (YYYY-MM-DD)"
  * results 0..1 BackboneElement "Histology results"
    * tumorCellContent 0..1 BackboneElement "Histologic tumor cell content"
      * id 1..1 string "Result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type (Patient)"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type (TumorSpecimen)"
      * method 0..1 BackboneElement "Determination method"
        * code 1..1 string "Method code (e.g. histologic)"
        * display 0..1 string "Method display"
        * system 1..1 string "Method system URI"
      * value 1..1 decimal "Tumor cell content fraction (0.0 – 1.0)"
    * tumorMorphology 0..1 BackboneElement "Tumor morphology"
      * id 1..1 string "Morphology result UUID"
      * patient 1..1 BackboneElement "Patient reference"
        * id 1..1 string "Patient ID"
        * type 1..1 string "Reference type (Patient)"
      * specimen 1..1 BackboneElement "Specimen reference"
        * id 1..1 string "Specimen ID"
        * type 1..1 string "Reference type (TumorSpecimen)"
      * morphology 0..* BackboneElement "ICD-O-3 morphology codes"
        * code 1..1 string "Morphology code"
        * display 0..1 string "Morphology display"
        * system 1..1 string "Morphology system URI (ICD-O-3)"
        * version 0..1 string "ICD-O-3 version"
      * notes 0..* string "Free-text morphology notes"

// =============================================================================
// 11. ihcReports
// =============================================================================
* ihcReports 0..* BackboneElement "Immunohistochemistry (IHC) reports"
